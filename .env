# Camera stream url (rtsp://... or local file like t3.mp4 for testing)
RTSP_URL=t4.mp4
ASSET_DETECTION=true
# Where the event engine writes log lines
LOG_FILE_PATH=logs/events.log
# Seconds to wait before reconnecting to the camera
RECONNECT_DELAY=5
# Every N seconds each stage logs its actual frames-per-second
STAT_INTERVAL=15
# Local Moondream model file (all detectors share it)
MOONDREAM_MODEL_PATH=models/moondream-0_5b-int4.mf.gz
# Vehicle movement: approved FOV polygon (0-1 points, empty = full frame), record dir
VEHICLE_FOV=
VEHICLE_RECORD_DIR=records/vehicles
# Annotated output: empty path + AUTO_SAVE=true names it after the input
# (t1.mp4 -> records/t1_ann.mp4). Set a path to force a file, or
# OUTPUT_AUTO_SAVE=false for live preview only.
OUTPUT_VIDEO_PATH=
OUTPUT_AUTO_SAVE=true
OUTPUT_FPS=10
OUTPUT_SHOW=true
# Preview window max size in px (downscaled to fit screen; 0 = no scaling)
OUTPUT_PREVIEW_WIDTH=1280
OUTPUT_PREVIEW_HEIGHT=720

# Alert engine email settings, can stay empty for now
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
ALERT_ENABLED=true
